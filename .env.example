# ThousandEyes API connection
# Bearer token: create one at
#   https://app.thousandeyes.com → Account Settings → Users and Roles
#   → Profile → User API Tokens
THOUSANDEYES_BEARER_TOKEN=

# Optional — default account group ID injected as the `aid` query param on
# every request that accepts it. Leave blank to use the token's home account.
THOUSANDEYES_ACCOUNT_GROUP_ID=

# MCP server transport bearer token (only used when transport.auth.type=bearer in thousand-eyes-mcp.yaml)
# THOUSANDEYES_MCP_TOKEN=
