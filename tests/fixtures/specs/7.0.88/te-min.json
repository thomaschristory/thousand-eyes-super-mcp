{
  "openapi": "3.0.1",
  "info": {"version": "7.0.88", "title": "ThousandEyes API (test fixture)"},
  "servers": [{"url": "https://api.thousandeyes.com/v7"}],
  "paths": {
    "/tests": {
      "get": {
        "tags": ["Tests"],
        "operationId": "getAllTests",
        "summary": "List all tests",
        "parameters": [
          {"name": "aid", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/tests/{testId}": {
      "get": {
        "tags": ["Tests"],
        "operationId": "getTest",
        "summary": "Get a single test",
        "parameters": [
          {"name": "testId", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/agents": {
      "get": {
        "tags": ["Agents"],
        "operationId": "getAgents",
        "summary": "List agents",
        "parameters": [
          {"name": "aid", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/alerts": {
      "get": {
        "tags": ["Alerts"],
        "operationId": "getAlerts",
        "summary": "List alerts (paginated, cursor)",
        "parameters": [
          {"name": "max", "in": "query", "required": false, "schema": {"type": "integer"}},
          {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "OK"}}
      },
      "post": {
        "tags": ["Alerts"],
        "operationId": "createAlertRule",
        "summary": "Create an alert rule",
        "requestBody": {
          "required": true,
          "description": "Alert rule body",
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/AlertRule"}}
          }
        },
        "responses": {"201": {"description": "Created"}}
      }
    },
    "/alerts/{alertId}/labels": {
      "put": {
        "tags": ["Alerts"],
        "operationId": "setAlertLabels",
        "summary": "Replace the labels on an alert",
        "parameters": [
          {"name": "alertId", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "description": "List of label IDs",
          "content": {
            "application/json": {"schema": {"type": "array", "items": {"type": "string"}}}
          }
        },
        "responses": {"200": {"description": "OK"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer"}
    },
    "schemas": {
      "AlertRule": {
        "allOf": [
          {"$ref": "#/components/schemas/AuditMeta"},
          {
            "type": "object",
            "required": ["ruleName"],
            "properties": {
              "ruleName": {"type": "string", "description": "Human-readable rule name"},
              "severity": {"$ref": "#/components/schemas/Severity"},
              "notify": {"type": "boolean", "description": "Send notifications", "default": false},
              "_links": {"$ref": "#/components/schemas/SelfLinks"}
            }
          }
        ]
      },
      "AuditMeta": {
        "type": "object",
        "properties": {
          "alertId": {"type": "string", "readOnly": true},
          "createdBy": {"type": "string", "readOnly": true}
        }
      },
      "Severity": {"type": "string", "enum": ["INFO", "WARNING", "CRITICAL"]},
      "SelfLinks": {
        "type": "object",
        "readOnly": true,
        "properties": {"self": {"type": "string"}}
      }
    }
  }
}
